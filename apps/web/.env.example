NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Never prefix this secret with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key
# Local OCR is the default and requires no key or billing.
CLAIM_OCR_PROVIDER=local
# Optional Google fallback. Do not prefix this secret with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=
CLAIM_OCR_MODEL=gemini-3.8-flash
# Local synthetic demo only. Keep false in Vercel production.
NEXT_PUBLIC_DEMO_MODE=false
